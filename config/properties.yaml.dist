space_type:
  # Default incremental MS SQL source view (monthly delta)
  source_view: "[YOUR_SOURCE_DB].[dbo].[YOUR_STAGING_DELTA_VIEW]"
  # Full historical staging view (triggered via CLI flag: fsv)
  full_source_view: "[YOUR_SOURCE_DB].[dbo].[YOUR_STAGING_FULL_VIEW]"

  # Database retry boundary constraints (Exponential Backoff with Jitter)
  # max_timeout_ms     - Total maximum time budget (in ms) allocated to write data to DB
  # initial_timeout_ms - Base delay interval (in ms) before the first retry attempt
  db_retry:
    max_timeout_ms: 60000
    initial_timeout_ms: 10000

  # Local LLM inference settings (Ollama / vLLM endpoint)
    llm:
    base_url: "http://localhost:11434"
    model_name: "qwen2.5:7b"
    temperature: 0.0
    num_ctx: 1536
    batch_size: 5
    timeout_seconds: 1800
    max_retries: 3
