<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.org">
<hibernate-configuration>
    <session-factory>
        <!-- HikariCP connection pool provider -->
        <property name="hibernate.connection.provider_class">org.hibernate.hikaricp.internal.HikariCPConnectionProvider</property>

        <!-- P6Spy wrapper driver and base JDBC URL -->
        <property name="hibernate.connection.driver_class">com.p6spy.engine.spy.P6SpyDriver</property>
        <property name="hibernate.connection.url">jdbc:p6spy:sqlserver://YOUR_DB_HOST:YOUR_DB_PORT</property>

        <!-- Database credentials -->
        <property name="hibernate.connection.username">YOUR_USERNAME</property>
        <property name="hibernate.connection.password">YOUR_PASSWORD</property>

        <!-- MS SQL Server JDBC driver properties (forwarded via Hikari DataSource) -->
        <property name="hibernate.hikari.dataSource.databaseName">YOUR_DB_NAME</property>
        <property name="hibernate.hikari.dataSource.encrypt">true</property>
        <property name="hibernate.hikari.dataSource.trustServerCertificate">true</property>
        <property name="hibernate.hikari.dataSource.loginTimeout">30</property>
        <property name="hibernate.hikari.dataSource.queryTimeout">60</property>

        <!-- HikariCP pool settings -->
        <property name="hibernate.hikari.maximumPoolSize">10</property>
        <property name="hibernate.hikari.minimumIdle">2</property>
        <property name="hibernate.hikari.connectionTimeout">30000</property>

        <!-- MS SQL Server dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.SQLServerDialect</property>

        <!-- JDBC batch processing optimization -->
        <property name="hibernate.jdbc.batch_size">50</property>
        <property name="hibernate.order_inserts">true</property>
        <property name="hibernate.order_updates">true</property>

        <!-- SQL logging (disabled in favor of P6Spy) -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>
        <property name="hibernate.highlight_sql">false</property>

        <!-- Schema management (validate, update, create, create-drop, none) -->
        <property name="hibernate.hbm2ddl.auto">validate</property>
    </session-factory>
</hibernate-configuration>
        